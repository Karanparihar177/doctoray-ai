APP_NAME=Doctoray AI
APP_VERSION=0.1.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Speech-to-text (Deepgram); put the real key in .env only
DEEPGRAM_AI_KEY=
# EU data residency: https://api.eu.deepgram.com
DEEPGRAM_BASE_URL=https://api.deepgram.com
DEEPGRAM_MODEL=nova-3

# LLM provider for note generation (not chosen yet)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=4
LLM_MAX_REPAIRS=2
LLM_MAX_OUTPUT_TOKENS=4096
